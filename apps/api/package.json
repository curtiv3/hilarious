{
  "name": "@hilarious/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "seed": "ts-node src/prisma/seed.ts",
