{
  "name": "hilarious",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "postinstall": "pnpm --filter @hilarious/api prisma:generate",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "seed": "pnpm --filter @hilarious/api seed"
  }
}
